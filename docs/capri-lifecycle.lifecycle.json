    { "id": "comms-interacting", "from": "comms_active", "to": "interacting", "label": "mouseenter / focus" },
    { "id": "interacting-comms", "from": "interacting", "to": "comms_active", "label": "mouseleave / blur" },
    { "id": "awake-vanish", "from": "awake", "to": "vanish", "label": "voice 'vanish'", "variant": "security" },
    { "id": "vanish-awake", "from": "vanish", "to": "awake", "label": "Alt+V / summon", "variant": "dashed" }
  ],
  "cards": [
