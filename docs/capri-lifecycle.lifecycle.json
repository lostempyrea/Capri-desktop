    { "id": "comms_active", "type": "active", "label": "Comms Active", "sublabel": "40/60 Split View & ticker", "tag": "active", "step": "04" },
    { "id": "interacting", "type": "waiting", "label": "User Interaction", "sublabel": "hover / input typing", "tag": "paused" },
    { "id": "auto_dismissing", "type": "decision", "label": "Auto-Dismissing", "sublabel": "9s timer expired", "tag": "collapse", "step": "05" },
    { "id": "vanish", "type": "failure", "label": "Vanish Mode", "sublabel": "zero opacity stealth", "tag": "stealth" }
