# ========================================================
# CẤU HÌNH API ĐỂ TRÒ CHUYỆN VỚI CAPRI ("Talk to her")
# ========================================================

# Dùng Google Gemini API (Miễn phí - Lấy key tại: https://aistudio.google.com/apikey)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=AIzaSy_your_gemini_api_key_here
# AI_MODEL=gemini-2.0-flash

# Hoặc dùng Groq (Miễn phí & Cực nhanh - Lấy key tại: https://console.groq.com)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b

# Hoặc dùng OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-your_openrouter_key_here
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ========================================================
# CẤU HÌNH DISCORD BOT CAPRI (Điều khiển từ xa & Phát nhạc)
# ========================================================
# Token lấy từ Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_PREFIX=c!
# (Tùy chọn) Chỉ cho phép 1 Discord User ID điều khiển bot:
DISCORD_ALLOWED_USER_ID=

# ========================================================
# CẤU HÌNH GIỌNG NÓI & WAKE WORD ("Hey Capri" - Whisper)
# ========================================================
GROQ_API_KEY=your_groq_api_key_here
STT_LANGUAGE=vi
STT_MODEL=whisper-large-v3-turbo
